LANGUAGE LANG_IRISH, SUBLANG_NEUTRAL

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_SOURCE DIALOG 0, 0, SETUP_STANDARD_DIALOG_DIMS STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_CHILD | WS_CAPTION | WS_SYSMENU CAPTION "Socrú Cygwin - Roghnaigh Cineál Suiteála" FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "&Suiteáil ón Idirlíon\n(coimeádfar comhaid íoslódála le haghaidh athúsáide sa todhchaí)",IDC_SOURCE_NETINST,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP | BS_MULTILINE | BS_TOP,71,60,200,30
    CONTROL         "& Íoslódáil Gan Suiteáil",IDC_SOURCE_DOWNLOAD,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,71,90,200,10
    CONTROL         "Suiteáil ón & Eolaire Áitiúil",IDC_SOURCE_LOCALDIR,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,71,120,200,10
    ICON            IDI_CYGWIN,IDC_HEADICON,SETUP_HEADICON_X,0,21,20
    CONTROL         "",IDC_HEADSEPARATOR,"Static",SS_BLACKFRAME | SS_SUNKEN,0,28,SETUP_STANDARD_DIALOG_W,1
    LTEXT           "Roghnaigh Foinse Íoslódáil",IDC_STATIC_HEADER_TITLE,7,0,258,8,NOT WS_GROUP
    LTEXT           "Roghnaigh cibé acu a shuiteáil nó a íoslódáil ón idirlíon, nó a shuiteáil ó chomhaid in eolaire áitiúil.",IDC_SOURCE_SUBTEXT,21,9,239,16,NOT WS_GROUP
END

IDD_VIRUS DIALOG 0, 0, SETUP_STANDARD_DIALOG_DIMS STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_CHILD | WS_CAPTION | WS_SYSMENU CAPTION "Socrú Cygwin - Díchumasaigh Scanóir Víreas?" FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "&Díchumasaigh scanóir víreas",IDC_DISABLE_AV,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,101,69,115,10
    CONTROL         "&Fág scanóir víreas ina aonar",IDC_LEAVE_AV,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,101,84,115,10
    ICON            IDI_CYGWIN,IDC_HEADICON,SETUP_HEADICON_X,0,21,20
    CONTROL         "",IDC_HEADSEPARATOR,"Static",SS_BLACKFRAME | SS_SUNKEN,0,28,SETUP_STANDARD_DIALOG_W,1
    LTEXT           "Roghnaigh cé acu an ndéanfaidh tú do scanóir víreas a dhíchumasú agus é á shuiteáil.",IDC_STATIC_HEADER_TITLE,7,0,258,8,NOT WS_GROUP
    LTEXT           "Is cúis le roinnt cláir Antivirus, go háirithe McAfee, scáileán gorm ar ríomhairí Windows XP le linn suiteáil Cygwin.",IDC_STATIC,21,9,239,16,NOT WS_GROUP
    LTEXT           "Braitheadh fadhb amháin a d’fhéadfadh a bheith ina fhadhb. Is féidir le socrú Cygwin é seo a dhíchumasú le linn an phróisis suiteála, agus é a chumasú arís nuair a bheidh an tsuiteáil críochnaithe.",IDC_STATIC,21,32,239,24,NOT WS_GROUP
END

IDD_LOCAL_DIR DIALOG 0, 0, SETUP_STANDARD_DIALOG_DIMS STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_CHILD | WS_CAPTION | WS_SYSMENU CAPTION "Socrú Cygwin - Roghnaigh Eolaire Pacáiste Áitiúil" FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Roghnaigh Eolaire Pacáistí",IDC_STATIC_HEADER_TITLE,7,0,258,8,NOT WS_GROUP
    LTEXT           "Roghnaigh eolaire inar mian leat Socrú chun na comhaid suiteála a íoslódálann sé a stóráil. Cruthófar an eolaire mura bhfuil sé ann cheana féin.",IDC_LOCAL_DIR_DOWNLOAD_DESC,21,9,248,16,NOT WS_GROUP
    LTEXT           "Roghnaigh eolaire inar chóir Socrú comhaid suiteála íoslódáilte a lorg.",IDC_LOCAL_DIR_INSTALL_DESC,21,9,248,16,NOT WS_GROUP
    ICON            IDI_CYGWIN,IDC_HEADICON,SETUP_HEADICON_X,0,21,20
    CONTROL         "",IDC_HEADSEPARATOR,"Static",SS_BLACKFRAME | SS_SUNKEN,0,28,SETUP_STANDARD_DIALOG_W,1
    GROUPBOX        "Eolaire Pacáiste Áitiúil",IDC_LOCALDIR_GRP,5,35,330,35
    EDITTEXT        IDC_LOCAL_DIR,13,47,262,14,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "B&rabhsáil...",IDC_LOCAL_DIR_BROWSE,277,47,52,14,WS_TABSTOP
END

IDD_ROOT DIALOG 0, 0, SETUP_STANDARD_DIALOG_DIMS STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_CHILD | WS_CAPTION | WS_SYSMENU CAPTION "Socrú Cygwin - Roghnaigh Eolaire Suiteála" FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Roghnaigh Root Install Directory",IDC_STATIC_HEADER_TITLE,7,0,258,8,NOT WS_GROUP
    LTEXT           "Roghnaigh an eolaire inar mian leat Cygwin a shuiteáil. Roghnaigh roinnt paraiméadair suiteála freisin.",IDC_ROOTDIR_SUBTEXT,21,9,239,16,NOT WS_GROUP
    ICON            IDI_CYGWIN,IDC_HEADICON,SETUP_HEADICON_X,0,21,20
    CONTROL         "",IDC_HEADSEPARATOR,"Static",SS_BLACKFRAME | SS_SUNKEN,0,28,SETUP_STANDARD_DIALOG_W,1
    GROUPBOX        "Eolaire fréimhe",IDC_ROOTDIR_GRP,5,35,330,35
    EDITTEXT        IDC_ROOT_DIR,13,47,262,14,ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "B&rabhsáil...",IDC_ROOT_BROWSE,277,47,52,14,WS_TABSTOP
    GROUPBOX        "Suiteáil Do",IDC_INSTALLFOR_GRP,5,76,330,101
    CONTROL         "&Gach Úsáideoir (MOLTA)",IDC_ROOT_SYSTEM,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP | WS_GROUP,13,89,130,8
    CONTROL         "Díreach &Mise",IDC_ROOT_USER,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,13,130,130,8
    LTEXT           "Beidh Cygwin ar fáil do gach úsáideoir den chórais.",IDC_ALLUSERS_TEXT,25,101,300,28
    LTEXT           "Beidh Cygwin fós ar fáil do gach úsáideoir, ach níl deilbhíní deisce, Iontrálacha Roghchlár Cygwin, agus faisnéis thábhachtach Suiteálaí ar fáil ach don úsáideoir reatha. Roghnaigh é seo ach mura bhfuil pribhléidí Riarthóra agat nó má tá riachtanais shonracha agat.",IDC_JUSTME_TEXT,25,140,300,32
END

