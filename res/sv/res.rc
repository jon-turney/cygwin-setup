IDD_SPLASH DIALOG 0, 0, SETUP_STANDARD_DIALOG_DIMS STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_CHILD | WS_CAPTION | WS_SYSMENU CAPTION "Cygwin-installation" FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Cygwin Nätutgåva-installationsprogram",IDC_STATIC_WELCOME_TITLE,115,1,195,24
    LTEXT           "Detta installationsprogram används för den initiala installationen av Cygwin-miljön samt alla efterföljande uppdateringar. Sidorna som följer kommer att vägleda dig genom installationen.\n\nObservera att vi endast installerar en basuppsättning paket som standard. Cygwin tillhandahåller ett stort antal paket som täcker en mängd olika syften.\n\nDu kan alltid köra det här programmet när som helst i framtiden för att lägga till, ta bort eller uppgradera paket efter behov.",IDC_SPLASH_TEXT,115,25,195,100
    ICON            IDI_CYGWIN,IDC_SPLASH_ICON,4,6,0,0,SS_ICON | SS_REALSIZEIMAGE
    LTEXT           "",IDC_VERSION,115,127,195,10
    LTEXT           "",IDC_SPLASH_COPYR,115,140,195,8
    LTEXT           "",IDC_SPLASH_URL,115,152,90,8
    LTEXT           "Bidra till översättningar av detta program.",IDC_SPLASH_TRANSLATE,115,164,195,8
END

IDD_DESKTOP DIALOG 0, 0, SETUP_STANDARD_DIALOG_DIMS STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_CHILD | WS_CAPTION | WS_SYSMENU CAPTION "Cygwin-installation - Installationsstatus och skapa ikoner" FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "Skapa ikon på skrivbor&det",IDC_ROOT_DESKTOP,"Button",BS_AUTOCHECKBOX,108,78,110,8
    CONTROL         "Lägg till ikon i &Start-menyn",IDC_ROOT_MENU,"Button",BS_AUTOCHECKBOX,108,93,140,8
    ICON            IDI_CYGWIN,IDC_HEADICON,SETUP_HEADICON_X,0,21,20
    CONTROL         "",IDC_HEADSEPARATOR,"Static",SS_BLACKFRAME | SS_SUNKEN,0,28,SETUP_STANDARD_DIALOG_W,1
    LTEXT           "Berätta om du vill att det ska skapa några ikoner för bekväm tillgång till Cygwin-miljön.",IDC_DESKTOP_HEADER_INSTALL,21,9,239,16,NOT WS_GROUP
    LTEXT           "Skapa ikoner",IDC_DESKTOP_HEADER_TITLE_INSTALL,7,0,258,8,NOT WS_GROUP
    LTEXT           "Visar installationsstatus i enbart-nedladdnings läget.",IDC_DESKTOP_HEADER_DOWNLOAD,21,9,239,16,NOT WS_GROUP
    LTEXT           "Installationen är klar",IDC_DESKTOP_HEADER_TITLE_DOWNLOAD,7,0,258,8,NOT WS_GROUP
    CONTROL         "",IDC_DESKTOP_SEPARATOR,"Static",SS_BLACKFRAME | SS_SUNKEN,0,135,SETUP_STANDARD_DIALOG_W,1
    LTEXT           "Installationsstatus",IDC_STATUS_HEADER,7,140,258,8,NOT WS_GROUP
    LTEXT           "Cygwin-installationen har slutförts.",IDC_STATUS,21,149,279,36,NOT WS_GROUP
END

