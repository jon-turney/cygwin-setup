IDD_DROPPED DIALOG 0, 0, SETUP_STANDARD_DIALOG_W, 142 STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU CAPTION "Cygwin-inställningar - Använda borttagna speglar?" FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Varning:",IDC_STATIC,7,8,40,8
    LTEXT           "En eller flera speglar du har valt är inte på listan över officiella Cygwin-speglar längre. De kan vara föråldrade eller saknas vissa paket.\nDetta påverkar följande spegel(ar):",IDC_STATIC,47,8,263,32
    EDITTEXT        IDC_DROP_MIRRORS,7,40,303,40,WS_VSCROLL | WS_HSCROLL | ES_LEFT | ES_MULTILINE | ES_READONLY | ES_AUTOHSCROLL | ES_AUTOVSCROLL
    LTEXT           "Om du upplever installationsproblem överväga att försöka med enbart officiella speglar.\n\nVill du fortsätta använda den/dessa speglar?",IDC_STATIC,7,88,303,24
    CONTROL         "&Varna mig inte om den här/dessa speglar igen",IDC_DROP_NOWARN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,120,213,15
    PUSHBUTTON      "&Ja",IDYES,220,120,45,15
    DEFPUSHBUTTON   "&Nej",IDNO,265,120,45,15
END

IDD_DOWNLOAD_ERROR DIALOG 0, 0, SETUP_STANDARD_DIALOG_DIMS STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU CAPTION "Nedladdningen är ofullständig" FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDI_WARNING,IDC_HEADICON,10,10
    LTEXT           "Följande paket hade nedladdningsfel:",IDC_STATIC,7,8,320,16
    EDITTEXT        IDC_DOWNLOAD_EDIT,7,24,320,88,WS_VSCROLL | ES_LEFT | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL
    LTEXT           "Välj ""Försök igen"" för att försöka ladda ner igen, ""Tillbaka"" för att återgå till sidan för paketval, ""Fortsätt"" för att fortsätta ändå (REKOMMENDERAS INTE) eller ""Avbryt"" för att avsluta.",IDC_STATIC,7,120,320,24
    DEFPUSHBUTTON   "&Försök igen",IDRETRY,45,150,50,15
    PUSHBUTTON      "&Tillbaka",IDC_BACK,110,150,50,15
    PUSHBUTTON      "&Fortsätt",IDIGNORE,175,150,50,15
    PUSHBUTTON      "Avbryt",IDABORT,240,150,50,15
END

IDD_POSTINSTALL DIALOG 0, 0, SETUP_STANDARD_DIALOG_W, 142 STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_CHILD | WS_CAPTION | WS_SYSMENU CAPTION "Cygwin-installation - Köra postinstallationsskript" FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "",IDC_HEADSEPARATOR,"Static",SS_BLACKFRAME | SS_SUNKEN,0,28,SETUP_STANDARD_DIALOG_W,1
    ICON            IDI_CYGWIN,IDC_HEADICON,SETUP_HEADICON_X,0,21,20
    LTEXT           "Postinstallation skriptfel",IDC_STATIC_HEADER_TITLE,7,0,258,8,NOT WS_GROUP
    LTEXT           "Detta betyder inte nödvändigtvis att berörda paket inte kommer att fungera korrekt, men vänligen kontrollera /var/log/setup.log.full och rapportera eventuella problem.",IDC_STATIC,21,9,239,16,NOT WS_GROUP
    EDITTEXT        IDC_POSTINSTALL_EDIT,7,41,303,112,WS_VSCROLL | WS_HSCROLL | ES_LEFT | ES_MULTILINE | ES_READONLY | ES_AUTOHSCROLL | ES_AUTOVSCROLL
END

IDD_FILE_INUSE DIALOG 0, 0, SETUP_MEDIUM_DIALOG_DIMS STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU CAPTION "Fil som används upptäcktes" FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDI_WARNING,IDC_HEADICON,10,10
    LTEXT           "Kan inte extrahera",IDC_FILE_INUSE_MSG,33,10,234,8,SS_PATHELLIPSIS
    LTEXT           "Filen används av följande processer:",IDC_STATIC,33,28,234,8
    EDITTEXT        IDC_FILE_INUSE_EDIT,33,40,234,32,WS_VSCROLL | ES_LEFT | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | NOT WS_TABSTOP
    LTEXT           "Välj ""Försök igen"" för att försöka igen, välj ""Stoppa"" för att stoppa processer och försöka igen, eller välj ""Fortsätt"" för att fortsätta ändå (filen uppdateras efter en omstart).",IDC_FILE_INUSE_HELP_0,33,80,234,24,NOT WS_GROUP
    LTEXT           "Välj ""Försök igen"" för att försöka igen, välj ""Avsluta"" för att avsluta processer och försöka igen, eller välj ""Fortsätt"" för att fortsätta ändå (filen uppdateras efter en omstart).",IDC_FILE_INUSE_HELP_1,33,80,234,24,NOT WS_GROUP
    LTEXT           "Välj ""Försök igen"" för att försöka igen, välj ""Avsluta"" för att tvångsavsluta alla processer och försöka igen, eller välj ""Fortsätt"" för att fortsätta ändå (filen uppdateras efter en omstart).",IDC_FILE_INUSE_HELP_2,33,80,234,24,NOT WS_GROUP
    PUSHBUTTON      "&Försök igen",IDIGNORE,45,112,55,15
    DEFPUSHBUTTON   "&Stoppa processer",IDRETRY,111,112,55,15
    PUSHBUTTON      "&Fortsätt",IDCONTINUE,177,112,55,15
END

