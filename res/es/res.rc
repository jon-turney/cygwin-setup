IDD_DROPPED DIALOG 0, 0, SETUP_STANDARD_DIALOG_W, 142 STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU CAPTION "Configuración Cygwin – ¿Utilizar espejos abandonados?" FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Aviso:",IDC_STATIC,7,8,40,8
    LTEXT           "Uno o más de los servidores espejo que has seleccionado ya no figuran en la lista de servidores espejo oficiales de Cygwin. Es posible que estén al día o que no tengan algunos paquetes.\nEsto afecta a los siguientes servidor(es) espejo:",IDC_STATIC,47,8,263,32
    EDITTEXT        IDC_DROP_MIRRORS,7,40,303,40,WS_VSCROLL | WS_HSCROLL | ES_LEFT | ES_MULTILINE | ES_READONLY | ES_AUTOHSCROLL | ES_AUTOVSCROLL
    LTEXT           "Si experimentas problemas de instalación, considera usar únicamente servidores espejo oficiales.\n\n¿Deseas continuar usando este/estos servidores espejo?",IDC_STATIC,7,88,303,24
    CONTROL         "&No avisarme otra vez sobre este/estos espejo(s)",IDC_DROP_NOWARN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,120,213,15
    PUSHBUTTON      "&Sí",IDYES,220,120,45,15
    DEFPUSHBUTTON   "&No",IDNO,265,120,45,15
END

IDD_DOWNLOAD_ERROR DIALOG 0, 0, SETUP_STANDARD_DIALOG_DIMS STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU CAPTION "Descarga Incompleta" FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDI_WARNING,IDC_HEADICON,10,10
    LTEXT           "Los siguientes paquetes presentaron errores de descarga:",IDC_STATIC,7,8,320,16
    EDITTEXT        IDC_DOWNLOAD_EDIT,7,24,320,88,WS_VSCROLL | ES_LEFT | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL
    LTEXT           "Seleccione 'Reintentar' para volver a intentar la descarga, 'Atrás' para regresar a la página de selección de paquetes, 'Continuar' para seguir adelante de todos modos (NO RECOMENDADO) o 'Cancelar' para salir.",IDC_STATIC,7,120,320,24
    DEFPUSHBUTTON   "&Reintentar",IDRETRY,45,150,50,15
    PUSHBUTTON      "&Atrás",IDC_BACK,110,150,50,15
    PUSHBUTTON      "&Continuar",IDIGNORE,175,150,50,15
    PUSHBUTTON      "Cancelar",IDABORT,240,150,50,15
END

IDD_POSTINSTALL DIALOG 0, 0, SETUP_STANDARD_DIALOG_W, 142 STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_CHILD | WS_CAPTION | WS_SYSMENU CAPTION "Configuración de Cygwin – Ejecución de scripts posteriores a la instalación" FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "",IDC_HEADSEPARATOR,"Static",SS_BLACKFRAME | SS_SUNKEN,0,28,SETUP_STANDARD_DIALOG_W,1
    ICON            IDI_CYGWIN,IDC_HEADICON,SETUP_HEADICON_X,0,21,20
    LTEXT           "Errores del script de postinstalación",IDC_STATIC_HEADER_TITLE,7,0,258,8,NOT WS_GROUP
    LTEXT           "Esto no significa necesariamente que los paquetes afectados vayan a dejar de funcionar correctamente, pero por favor, revise el archivo /var/log/setup.log.full e informe de cualquier problema.",IDC_STATIC,21,9,239,16,NOT WS_GROUP
    EDITTEXT        IDC_POSTINSTALL_EDIT,7,41,303,112,WS_VSCROLL | WS_HSCROLL | ES_LEFT | ES_MULTILINE | ES_READONLY | ES_AUTOHSCROLL | ES_AUTOVSCROLL
END

IDD_FILE_INUSE DIALOG 0, 0, SETUP_MEDIUM_DIALOG_DIMS STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU CAPTION "Archivo en uso detectado" FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDI_WARNING,IDC_HEADICON,10,10
    LTEXT           "No es capaz de extraer",IDC_FILE_INUSE_MSG,33,10,234,8,SS_PATHELLIPSIS
    LTEXT           "El archivo está en uso por los siguientes procesos:",IDC_STATIC,33,28,234,8
    EDITTEXT        IDC_FILE_INUSE_EDIT,33,40,234,32,WS_VSCROLL | ES_LEFT | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | NOT WS_TABSTOP
    LTEXT           "Seleccione 'Reintentar' para reintentar, seleccione 'Detener' para detener procesos y reintentar, o seleccione 'Continuar' para ir a cualquier lugar (el archivo estará actualizado tras un reinicio).",IDC_FILE_INUSE_HELP_0,33,80,234,24,NOT WS_GROUP
    LTEXT           "Seleccione 'Reintentar' para volver a intentarlo, seleccione 'Matar' para matar los procesos y volver a intentarlo, o seleccione 'Continuar' para seguir adelante de todos modos (el archivo se actualizará tras reiniciar).",IDC_FILE_INUSE_HELP_1,33,80,234,24,NOT WS_GROUP
    LTEXT           "Seleccione 'Reintentar' para volver a intentarlo, seleccione 'Matar' para matar forzosamente todos los procesos y volver a intentarlo, o seleccione 'Continuar' para seguir adelante de todos modos (el archivo se actualizará tras reiniciar el sistema).",IDC_FILE_INUSE_HELP_2,33,80,234,24,NOT WS_GROUP
    PUSHBUTTON      "&Reintentar",IDIGNORE,45,112,55,15
    DEFPUSHBUTTON   "&Detener Procesos",IDRETRY,111,112,55,15
    PUSHBUTTON      "&Continuar",IDCONTINUE,177,112,55,15
END

