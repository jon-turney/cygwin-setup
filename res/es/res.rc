    LTEXT           "Indícale al programa de configuración si quieres que cree algunos iconos para acceder fácilmente al entorno de Cygwin.",IDC_DESKTOP_HEADER_INSTALL,21,9,239,16,NOT WS_GROUP
    LTEXT           "Crear Iconos",IDC_DESKTOP_HEADER_TITLE_INSTALL,7,0,258,8,NOT WS_GROUP
    LTEXT           "Muestra el estado de la instalación en el modo solo-descarga.",IDC_DESKTOP_HEADER_DOWNLOAD,21,9,239,16,NOT WS_GROUP
    LTEXT           "Instalación completa",IDC_DESKTOP_HEADER_TITLE_DOWNLOAD,7,0,258,8,NOT WS_GROUP
    CONTROL         "",IDC_DESKTOP_SEPARATOR,"Static",SS_BLACKFRAME | SS_SUNKEN,0,135,SETUP_STANDARD_DIALOG_W,1
    LTEXT           "Estado de Instalación",IDC_STATUS_HEADER,7,140,258,8,NOT WS_GROUP
    LTEXT           "Instalación de Cygwin completada correctamente.",IDC_STATUS,21,149,279,36,NOT WS_GROUP
END

